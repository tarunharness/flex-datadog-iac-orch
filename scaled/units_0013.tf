  special = false
}

resource "random_password" "pw_699" {
  length  = 32
  special = true
}

resource "tls_private_key" "key_699" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "null_resource" "null_699" {
  triggers = {
    unit        = "699"
    environment = var.environment
    note        = "scaled mixed-resource unit 699 for flex-orchestration"
    fingerprint = ""
  }
}

resource "terraform_data" "td_699" {
  input = {
    unit        = "699"
    environment = var.environment
    kind        = "scaled-mixed"
    fingerprint = ""
  }
}

resource "local_file" "file_699" {
  filename = "${path.module}/out/unit_699.txt"
  content  = "flex-orchestration scaled unit 699 in ${var.environment}\\n"
}

resource "aws_s3_bucket" "bucket_699" {
  bucket        = "flexorch-scaled-699-${random_id.id_699.hex}"
  force_destroy = true

  tags = {
    Name        = "flexorch-scaled-699"
    Environment = var.environment
    Service     = "flex-orchestration"
    ManagedBy   = "terraform"
    tag_00_unit699 = "flexorch-scaled-unit-699-tag-0-value"
    tag_01_unit699 = "flexorch-scaled-unit-699-tag-1-value"
    tag_02_unit699 = "flexorch-scaled-unit-699-tag-2-value"
    tag_03_unit699 = "flexorch-scaled-unit-699-tag-3-value"
  }
}

resource "aws_iam_role" "role_699" {
  name = "flexorch-scaled-role-699"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })

  tags = {
    Environment = var.environment
    Unit        = "699"
    Service     = "flex-orchestration"
  }
}

resource "aws_iam_role_policy" "policy_699" {
  name = "flexorch-scaled-policy-699"
  role = aws_iam_role.role_699.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "flexorchScaledUnit699Stmt0"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-699-stmt0/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-699-stmt0"
        ]
      },
      {
        Sid    = "flexorchScaledUnit699Stmt1"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-699-stmt1/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-699-stmt1"
        ]
      },
      {
        Sid    = "flexorchScaledUnit699Stmt2"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-699-stmt2/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-699-stmt2"
        ]
      }
    ]
  })
}

resource "aws_security_group" "sg_699" {
  name        = "flexorch-scaled-sg-699"
  description = "Scaled mixed-resource security group for unit 699"
  vpc_id      = "vpc-12345678"

  ingress {
    description = "unit 699 rule 0 for flex-orchestration service"
    from_port   = 1024
    to_port     = 1024
    protocol    = "tcp"
    cidr_blocks = ["10.199.1.0/24"]
  }
  ingress {
    description = "unit 699 rule 1 for flex-orchestration service"
    from_port   = 1025
    to_port     = 1025
    protocol    = "tcp"
    cidr_blocks = ["10.199.2.0/24"]
  }
  ingress {
    description = "unit 699 rule 2 for flex-orchestration service"
    from_port   = 1026
    to_port     = 1026
    protocol    = "tcp"
    cidr_blocks = ["10.199.3.0/24"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Environment = var.environment
    Unit        = "699"
    Service     = "flex-orchestration"
  }
}

resource "aws_dynamodb_table" "table_699" {
  name         = "flexorch-scaled-699"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"

  attribute {
    name = "id"
    type = "S"
  }
  attribute {
    name = "gsi_key_0"
    type = "S"
  }
  attribute {
    name = "gsi_key_1"
    type = "S"
  }

  global_secondary_index {
    name            = "flexorch-scaled-699-gsi-0"
    hash_key        = "gsi_key_0"
    projection_type = "ALL"
  }
  global_secondary_index {
    name            = "flexorch-scaled-699-gsi-1"
    hash_key        = "gsi_key_1"
    projection_type = "ALL"
  }

  tags = {
    Environment = var.environment
    Unit        = "699"
    Service     = "flex-orchestration"
  }
}
