  special = false
}

resource "random_password" "pw_1098" {
  length  = 32
  special = true
}

resource "tls_private_key" "key_1098" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "null_resource" "null_1098" {
  triggers = {
    unit        = "1098"
    environment = var.environment
    note        = "scaled mixed-resource unit 1098 for flex-orchestration"
    fingerprint = ""
  }
}

resource "terraform_data" "td_1098" {
  input = {
    unit        = "1098"
    environment = var.environment
    kind        = "scaled-mixed"
    fingerprint = ""
  }
}

resource "local_file" "file_1098" {
  filename = "${path.module}/out/unit_1098.txt"
  content  = "flex-orchestration scaled unit 1098 in ${var.environment}\\n"
}

resource "aws_s3_bucket" "bucket_1098" {
  bucket        = "flexorch-scaled-1098-${random_id.id_1098.hex}"
  force_destroy = true

  tags = {
    Name        = "flexorch-scaled-1098"
    Environment = var.environment
    Service     = "flex-orchestration"
    ManagedBy   = "terraform"
    tag_00_unit1098 = "flexorch-scaled-unit-1098-tag-0-value"
    tag_01_unit1098 = "flexorch-scaled-unit-1098-tag-1-value"
    tag_02_unit1098 = "flexorch-scaled-unit-1098-tag-2-value"
    tag_03_unit1098 = "flexorch-scaled-unit-1098-tag-3-value"
  }
}

resource "aws_iam_role" "role_1098" {
  name = "flexorch-scaled-role-1098"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })

  tags = {
    Environment = var.environment
    Unit        = "1098"
    Service     = "flex-orchestration"
  }
}

resource "aws_iam_role_policy" "policy_1098" {
  name = "flexorch-scaled-policy-1098"
  role = aws_iam_role.role_1098.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "flexorchScaledUnit1098Stmt0"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-1098-stmt0/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-1098-stmt0"
        ]
      },
      {
        Sid    = "flexorchScaledUnit1098Stmt1"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-1098-stmt1/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-1098-stmt1"
        ]
      },
      {
        Sid    = "flexorchScaledUnit1098Stmt2"
        Effect = "Allow"
        Action = [
          "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "dynamodb:GetItem", "dynamodb:PutItem"
        ]
        Resource = [
          "arn:aws:s3:::flexorch-scaled-1098-stmt2/*",
          "arn:aws:dynamodb:us-east-1:000000000000:table/flexorch-scaled-1098-stmt2"
        ]
      }
    ]
  })
}

resource "aws_security_group" "sg_1098" {
  name        = "flexorch-scaled-sg-1098"
  description = "Scaled mixed-resource security group for unit 1098"
  vpc_id      = "vpc-12345678"

  ingress {
    description = "unit 1098 rule 0 for flex-orchestration service"
    from_port   = 1024
    to_port     = 1024
    protocol    = "tcp"
    cidr_blocks = ["10.98.1.0/24"]
  }
  ingress {
    description = "unit 1098 rule 1 for flex-orchestration service"
    from_port   = 1025
    to_port     = 1025
    protocol    = "tcp"
    cidr_blocks = ["10.98.2.0/24"]
  }
  ingress {
    description = "unit 1098 rule 2 for flex-orchestration service"
    from_port   = 1026
    to_port     = 1026
    protocol    = "tcp"
    cidr_blocks = ["10.98.3.0/24"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Environment = var.environment
    Unit        = "1098"
    Service     = "flex-orchestration"
  }
}

resource "aws_dynamodb_table" "table_1098" {
  name         = "flexorch-scaled-1098"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"

  attribute {
    name = "id"
    type = "S"
  }
  attribute {
    name = "gsi_key_0"
    type = "S"
  }
  attribute {
    name = "gsi_key_1"
    type = "S"
  }

  global_secondary_index {
    name            = "flexorch-scaled-1098-gsi-0"
    hash_key        = "gsi_key_0"
    projection_type = "ALL"
  }
  global_secondary_index {
    name            = "flexorch-scaled-1098-gsi-1"
    hash_key        = "gsi_key_1"
    projection_type = "ALL"
  }

  tags = {
    Environment = var.environment
    Unit        = "1098"
    Service     = "flex-orchestration"
  }
}

